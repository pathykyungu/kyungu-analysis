"""
Analyse Sommatielle - Régularisation des Séries Divergentes
Inspiré des travaux de recherche de l'école de Likasi (Pr. Pathy Kyungu Ngoïe).

Ce module implémente l'approximation canonique (asymptotique naturelle),
le degré de divergence p, et extrait la constante de normalisation intrinsèque (epsilon_0).
"""

import numpy as np
import scipy.special as sp
from sympy import symbols, diff, limit, oo, Poly, Bernoulli

class AnalyseSommatielle:
    def __init__(self):
        self.x = symbols('x')
        
    def determiner_degre_divergence(self, expr_F):
        """
        Définition 5.1 : Détermine le plus petit entier p >= 0 tel que lim (d^p/dx^p) F(x) = 0
         lorsque x tend vers +infini.
        """
        p = 0
        while p < 10:  # Limite de sécurité pour la boucle
            derivee = diff(expr_F, self.x, p)
            limite = limit(derivee, self.x, oo)
            if limite == 0:
                return p
            p += 1
        raise ValueError("Le degré de divergence est trop élevé ou indéterminé.")

    def calcul_asymptotique_naturelle(self, expr_F, p, omega=0):
        """
        Section 5.1 : Calcule la fonction g(x), approximation canonique de la somme partielle
        g(x) = integrale_omega_x(F(t)dt) + somme_{k=1}^p ( (B_k^+ / k!) * F^(k-1)(x) )
        """
        # 1. Composante intégrale
        t = symbols('t')
        expr_t = expr_F.subs(self.x, t)
        composante_integrale = sp.integrate if hasattr(sp, 'integrate') else None
        # Utilisation de la primitive symbolique de SymPy
        from sympy import integrate
        I_x = integrate(expr_t, (t, omega, self.x))
        
        # 2. Composante discrète de Bernoulli (Nombres de Bernoulli modifiés B_k^+)
        # En dehors de B_1 = -1/2 qui devient B_1^+ = +1/2, B_k^+ = B_k pour k > 1
        composante_bernoulli = 0
        for k in range(1, p + 1):
            bk_plus = 1/2 if k == 1 else Bernoulli(k)
            derivee_k = diff(expr_F, self.x, k - 1)
            fact = np.math.factorial(k)
            composante_bernoulli += (bk_plus / fact) * derivee_k
            
        g_x = I_x + composante_bernoulli
        return g_x.simplify()

    def extraire_constante_normalisation(self, c_exposant):
        """
        Section 5.3 : Extrait epsilon_0, la constante de normalisation intrinsèque,
        qui coïncide avec le prolongement analytique de la puissance via la fonction Zêta de Riemann.
        Pour F(t) = t^c, l'Hypersommatiel limite renvoie zeta(-c).
        """
        # La note démontre que l'écart asymptotique se résout symboliquement par la valeur de Zêta
        # Pour une puissance pure t^c, epsilon_0 = zeta(-c)
        try:
            return sp.zeta(-c_exposant)
        except TypeError:
            # Fallback si c est un flottant/entier standard pour SciPy
            return float(sp.zeta(-c_exposant))

