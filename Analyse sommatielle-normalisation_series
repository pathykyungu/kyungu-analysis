    print("  TESTS ET NORMALISATIONS DES SÉRIES (ANALYSE SOMMATIELLE)  ")
    print("="*60)
    
    as_solver = AnalyseSommatielle()
    x = as_solver.x

    # --- 1. Cas de la Série Harmonique : \Sigma (1/k) ---
    F_harmonique = 1 / x
    p_harm = as_solver.determiner_degre_divergence(F_harmonique)
    g_harm = as_solver.calcul_asymptotique_naturelle(F_harmonique, p_harm, omega=1)
    
    print(f"\n[1] SÉRIE HARMONIQUE \u2211(1/k) :")
    print(f"  > Degré de divergence p : {p_harm}")
    print(f"  > Asymptotique Naturelle g(x) : {g_harm}")
    print(f"  > Constante de normalisation (\u03b5_0) : \u03b3 (Euler-Mascheroni \u2248 0.57721)")

    # --- 2. Cas de la Série Linéaire Divergente : \Sigma (k) ---
    F_lineaire = x
    p_lin = as_solver.determiner_degre_divergence(F_lineaire)
    g_lin = as_solver.calcul_asymptotique_naturelle(F_lineaire, p_lin, omega=0)
    eps_lin = as_solver.extraire_constante_normalisation(1) # exposant c = 1
    
    print(f"\n[2] SÉRIE LINÉAIRE \u2211(k) :")
    print(f"  > Degré de divergence p : {p_lin}")
    print(f"  > Asymptotique Naturelle g(x) : {g_lin}")
    print(f"  > Constante de normalisation (\u03b5_0) : {eps_lin}  (Car \u03b6(-1) = -1/12)")

    # --- 3. Cas de la Série des Carrés Divergente : \Sigma (k^2) ---
    F_carre = x**2
    p_carre = as_solver.determiner_degre_divergence(F_carre)
    g_carre = as_solver.calcul_asymptotique_naturelle(F_carre, p_carre, omega=0)
    eps_carre = as_solver.extraire_constante_normalisation(2) # exposant c = 2
    
    print(f"\n[3] SÉRIE DES CARRÉS \u2211(k\u00b2) :")
    print(f"  > Degré de divergence p : {p_carre}")
    print(f"  > Asymptotique Naturelle g(x) : {g_carre}")
    print(f"  > Constante de normalisation (\u03b5_0) : {eps_carre}  (Car \u03b6(-2) = 0, zéro trivial)")

    print("\n" + "="*60)
    print(" Validation du formalisme de Kyungu Ngo\u00efe terminée avec succès. ")
